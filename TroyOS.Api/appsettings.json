{
  "Gemini": {
    "Model": "gemini-3.6-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 30
  },
  "PromptRefinement": {
    "MaximumPromptCharacters": 12000,
    "MaximumRequestBytes": 14000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7195",
      "http://localhost:5195"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "TrustedProxyIps": []
  }
}
