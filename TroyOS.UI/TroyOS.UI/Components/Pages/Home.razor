@page "/"

@using Microsoft.AspNetCore.Components

<PageTitle>TroyOS | Engineering Leader &amp; AI Builder</PageTitle>

<div class="portfolio-shell @(isDarkMode ? "theme-dark" : string.Empty)">
    <header>
        <nav class="navbar navbar-expand-lg sticky-top portfolio-nav" aria-label="Primary navigation">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand brand-mark" href="#top" aria-label="TroyOS home">Troy<span>OS</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portfolioNav"
                        aria-controls="portfolioNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="portfolioNav">
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-4">
                        <a class="nav-link" href="#dashboard">Dashboard</a>
                        <a class="nav-link" href="#journey">Journey</a>
                        <a class="nav-link" href="#now">Now</a>
                        <span class="nav-divider d-none d-lg-block" aria-hidden="true"></span>
                        <button class="theme-toggle nav-link" type="button" @onclick="ToggleTheme" aria-label="Toggle color theme">
                            <i class="bi @(isDarkMode ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="top">
        <section id="dashboard" class="hero-section container-fluid px-4 px-lg-5" aria-labelledby="hero-title">
            <div class="row align-items-center hero-content">
                <div class="col-lg-6 hero-copy">
                    <h1 id="hero-title" class="hero-title headline-gradient">TROY<br />ESCARTIN</h1>
                    <div class="subtitle-row d-flex flex-wrap align-items-center gap-2 gap-md-3" aria-label="Roles">
                        <strong>Engineering Leader</strong><span aria-hidden="true">•</span>
                        <strong>AI Builder</strong><span aria-hidden="true">•</span>
                        <strong>Speaker</strong>
                    </div>
                    <p class="hero-description">Helping teams build better software through leadership, architecture, and AI. I turn ideas into impact.</p>
                    <div class="hero-actions d-flex flex-wrap gap-3">
                        <a class="btn btn-dark hero-button" href="#journey">View Journey <i class="bi bi-arrow-right ms-3"></i></a>
                        <a class="btn btn-outline-dark hero-button" href="#now">What I’m Doing Now <i class="bi bi-arrow-right ms-3"></i></a>
                    </div>
                    <div class="social-links d-flex gap-3 mt-4" aria-label="Social links">
                        <a class="social-button" href="https://www.linkedin.com" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a class="social-button" href="https://github.com" aria-label="GitHub"><i class="bi bi-github"></i></a>
                        <a class="social-button" href="mailto:hello@troyos.dev" aria-label="Email"><i class="bi bi-envelope"></i></a>
                        <a class="social-button" href="mailto:hello@troyos.dev?subject=Let's%20connect" aria-label="Schedule a conversation"><i class="bi bi-calendar3"></i></a>
                    </div>
                </div>
                <div class="col-lg-6 hero-visual" aria-label="Portrait of Troy Escartin">
                    <div class="radial-rings" aria-hidden="true"></div>
                    <div class="dot-grid" aria-hidden="true"></div>
                    <img class="hero-photo" src="/images/troy.png" alt="Troy Escartin in a blue suit" />
                </div>
            </div>

            <div class="row g-3 g-xl-4 capability-cards" id="journey">
                @foreach (var card in capabilities)
                {
                    <div class="col">
                        <article class="glass-card capability-card h-100">
                            <div class="capability-icon"><i class="bi @card.Icon"></i></div>
                            <div><h2>@card.Title</h2><ul>@foreach (var item in card.Items) { <li>@item</li> }</ul></div>
                        </article>
                    </div>
                }
            </div>
            @* <div class="scroll-cue d-none d-md-flex" aria-hidden="true"><span>SCROLL TO EXPLORE</span><i class="bi bi-mouse"></i><i class="bi bi-arrow-down"></i></div> *@
        </section>

        <section id="now" class="content-section container-fluid px-4 px-lg-5" aria-labelledby="focus-heading">
            <h2 class="section-heading" id="focus-heading"><i class="bi bi-crosshair"></i> CURRENT FOCUS</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-4 focus-grid">
                @foreach (var item in focusItems)
                {
                    <div class="col">
                        <article class="glass-card focus-tile">
                            <span class="num-badge">@item.Number</span>
                            <div class="focus-content">
                                <h3>@item.Text</h3>
                                <p class="focus-details">@item.Details</p>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <h2 class="section-heading"><i class="bi bi-star"></i> LEADERSHIP PRINCIPLES</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-3">
                @foreach (var item in principles)
                {
                    <div class="col"><article class="glass-card principle-tile"><span class="principle-badge">@item.Number</span><span>@item.Text</span></article></div>
                }
            </div>
        </section>

        <footer class="site-footer" aria-label="Site footer">
            <div class="footer-content">
                <div class="footer-main-grid">
                    <section class="footer-brand" aria-labelledby="footer-brand-title">
                        <h2 id="footer-brand-title" class="footer-brand-mark">Troy<span>OS</span></h2>
                        <p class="footer-roles">Engineering Leader <span>•</span> AI Builder <span>•</span> Speaker</p>
                        <p class="footer-description">Building better software through leadership, architecture, and AI.</p>
                        <div class="footer-social-links" aria-label="Social links">
                            <a class="footer-social-button" href="https://www.linkedin.com" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a class="footer-social-button" href="https://github.com" aria-label="GitHub"><i class="bi bi-github"></i></a>
                            <a class="footer-social-button" href="mailto:hello@troyos.dev" aria-label="Email"><i class="bi bi-envelope"></i></a>
                            <a class="footer-social-button" href="mailto:hello@troyos.dev?subject=Let's%20connect" aria-label="Schedule a conversation"><i class="bi bi-calendar3"></i></a>
                        </div>
                    </section>

                    <section class="footer-column" aria-labelledby="footer-navigate-title">
                        <h2 id="footer-navigate-title">Navigate</h2>
                        <a href="#dashboard"><i class="bi bi-house"></i>Dashboard</a>
                        <a href="#dashboard"><i class="bi bi-person"></i>About Me</a>
                        <a href="#journey"><i class="bi bi-briefcase"></i>Journey</a>
                        <a href="#now"><i class="bi bi-chat-square"></i>Speaking</a>
                        <a href="mailto:hello@troyos.dev"><i class="bi bi-envelope"></i>Contact</a>
                    </section>

                    <section class="footer-column" aria-labelledby="footer-expertise-title">
                        <h2 id="footer-expertise-title">Expertise</h2>
                        <a href="#now"><i class="bi bi-dot"></i>Software Architecture</a>
                        <a href="#now"><i class="bi bi-dot"></i>AI &amp; Automation</a>
                        <a href="#now"><i class="bi bi-dot"></i>Cloud &amp; Azure</a>
                        <a href="#now"><i class="bi bi-dot"></i>Agile Leadership</a>
                        <a href="#now"><i class="bi bi-dot"></i>Team Growth</a>
                    </section>

                    <section class="footer-connect" aria-labelledby="footer-connect-title">
                        <h2 id="footer-connect-title">Let’s Connect</h2>
                        <p>I’m always open to discussing new opportunities, collaborations, and ways to create impact together.</p>
                        <a class="footer-connect-button" href="mailto:hello@troyos.dev"> <i class="bi bi-send"></i><span>Say Hello</span><i class="bi bi-arrow-right"></i></a>
                    </section>
                </div>

                <div class="footer-bottom">
                    <div class="footer-copyright"><i class="bi bi-shield-check"></i><div><span>© 2025 Troy Escartin. All rights reserved.</span><small>Built with passion. Driven by purpose.</small></div></div>
                    <blockquote>“Ideas are easy.<br />Impact is intentional.”</blockquote>
                    <div class="footer-legal"><a href="#now">Privacy Policy</a><span>•</span><a href="#now">Terms of Use</a><span>•</span><a href="#now">Sitemap</a><a class="back-to-top" href="#top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></a></div>
                </div>
            </div>
        </footer>
    </main>
</div>

@code {
    private bool isDarkMode;

    private void ToggleTheme() => isDarkMode = !isDarkMode;

    private readonly (string Icon, string Title, string[] Items)[] capabilities =
    [
        ("bi-code-slash", "Builder", [".NET", "Blazor", "Azure", "AI & Automation", "Cloud & Modern Web"]),
        ("bi-people", "Leader", ["Agile Delivery", "Team Growth", "Coaching & Mentoring", "Strategy", "Innovation"]),
        ("bi-mic", "Speaker", ["Toastmasters", "Communication", "Leadership", "Mentoring", "Public Speaking"])
    ];

    private readonly (string Number, string Text, string Details)[] focusItems =
    [
        //("01", "Spec Driven Development", "Define the expected behavior before implementation begins. Use clear specifications to align teams, reduce ambiguity, and make changes easier to validate. Deliver software that is guided by intent rather than assumptions."),
        ("01", "AI Assisted Engineering", "Use AI to accelerate research, coding, testing, and documentation. Keep engineering judgment and review at the center of every decision. Build faster while preserving quality, security, and maintainability."),
        ("02", "Developer Productivity", "Remove friction from the tools, workflows, and feedback loops developers use every day. Automate repetitive work so teams can focus on solving meaningful problems. Measure improvement through flow, focus, and sustainable delivery."),
        ("03", "Engineering Excellence", "Create a culture where quality is built into every stage of delivery. Favor reliable architecture, thoughtful testing, observability, and continuous improvement. Excellence means making good engineering practices repeatable across the team."),
        //("05", "Cloudflare & Modern Hosting", "Use modern hosting platforms to deliver secure, fast, and resilient web experiences. Combine edge delivery, automation, and practical cloud architecture to keep operations simple. Choose infrastructure that scales with the product and the people supporting it.")
    ];

    private readonly (string Number, string Text)[] principles =
    [
        ("01", "Build systems, not heroics."), ("02", "Clarity beats complexity."),
        ("03", "AI amplifies teams."), ("04", "Learning compounds."),
        ("05", "Great teams win together.")
    ];
}
