@using Microsoft.JSInterop

<section class="pb-result container-fluid px-4 px-lg-5" aria-labelledby="pb-result-title">
    <header class="pb-result-topbar">
        <button type="button" class="pb-result-back" @onclick="() => OnBackToChat.InvokeAsync()">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Chat
        </button>
        <span class="pb-result-status" aria-live="polite">Your Prompt is Ready!</span>
        <button type="button" class="btn btn-outline-dark pb-start-over" @onclick="() => OnStartOver.InvokeAsync()">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Start Over
        </button>
    </header>

    <section class="pb-result-intro" aria-labelledby="pb-result-title">
        <div class="pb-result-icon" aria-hidden="true"><i class="bi bi-stars"></i></div>
        <h1 id="pb-result-title">Here's your custom prompt</h1>
        <p>Use it with ChatGPT, Claude, Gemini, or any AI assistant.</p>
        <div class="pb-result-actions">
            <button type="button" class="btn btn-dark pb-result-primary" @onclick="CopyAsync">
                <i class="bi @(_copySucceeded ? "bi-check2" : "bi-clipboard")" aria-hidden="true"></i>
                @(_copySucceeded ? "Copied!" : "Copy Prompt")
            </button>
            <a class="btn btn-outline-dark pb-result-action" href="@DownloadHref" download="troy-prompt.txt">
                <i class="bi bi-download" aria-hidden="true"></i> Download
            </a>
        </div>
    </section>

    <section class="pb-result-prompt" aria-labelledby="pb-prompt-heading">
        <div class="pb-result-section-heading">
            <h2 id="pb-prompt-heading">Your Prompt</h2>
            <span class="pb-recommended-badge">Recommended for: ChatGPT, Claude, Gemini</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(RefinementError))
        {
            <p class="pb-refinement-error" role="alert">@RefinementError</p>
        }
        <div class="pb-result-code-container">
            <pre class="pb-result-code"><code>@(ImprovedPrompt ?? AssembledPrompt)</code></pre>
            @if (IsRefining)
            {
                <div class="pb-result-code-loader" role="status" aria-live="polite">
                    <span class="pb-result-loading-spinner" aria-hidden="true"></span>
                    <span>Generating your improved prompt...</span>
                </div>
            }
        </div>
        <details class="pb-why-prompt">
            <summary>Why this prompt works</summary>
            <p>It provides clear context, structure, and expectations to get high-quality, relevant results.</p>
        </details>
    </section>

    <section class="pb-result-next" aria-labelledby="pb-next-heading">
        <h2 id="pb-next-heading">Keep improving!</h2>
        <p>Refine your prompt or start a new one to get even better results.</p>
        <button type="button" class="btn btn-outline-dark" @onclick="() => OnStartOver.InvokeAsync()">
            Build Another Prompt <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
    </section>
</section>

@code {
    [Parameter, EditorRequired] public string AssembledPrompt { get; set; } = string.Empty;
    [Parameter] public string? ImprovedPrompt { get; set; }
    [Parameter] public string? RefinementError { get; set; }
    [Parameter] public bool IsRefining { get; set; }
    [Parameter] public EventCallback OnBackToChat { get; set; }
    [Parameter] public EventCallback OnStartOver { get; set; }
    [Parameter] public IJSObjectReference? JsModule { get; set; }

    private bool _copySucceeded;

    private string DisplayedPrompt => ImprovedPrompt ?? AssembledPrompt;

    private string DownloadHref =>
        $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(DisplayedPrompt)}";

    private async Task CopyAsync()
    {
        if (JsModule is null || string.IsNullOrWhiteSpace(DisplayedPrompt))
        {
            return;
        }

        _copySucceeded = await JsModule.InvokeAsync<bool>("copyText", DisplayedPrompt);
        if (_copySucceeded)
        {
            StateHasChanged();
            await Task.Delay(2000);
            _copySucceeded = false;
            StateHasChanged();
        }
    }
}