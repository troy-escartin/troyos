<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(TroyOS.UI.Client.Components.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(TroyOS.UI.Client.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
